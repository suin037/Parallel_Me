# 로컬 개발용 예시. 실제 키가 든 .env 는 커밋되지 않는다(.gitignore).
ANTHROPIC_API_KEY=sk-ant-...
DART_API_KEY=            # OpenDART 공시·재무 (기업 분석)
CAREERNET_API_KEY=       # 커리어넷 직업정보·직업가치관검사

# ── 배포할 때만 ────────────────────────────────────────────
# 우리 프론트 주소만 허용해 키 도용을 막는다. 비우면 전부 허용.
# ALLOWED_ORIGINS=https://내프론트주소
# PORT 는 호스팅 플랫폼이 준다(Render/Railway 등). 있으면 0.0.0.0 으로 바인딩한다.

# ── 모델 아티팩트 내려받기 (scripts/fetch_artifacts.py) ─────
# backend/models/artifacts/*.pkl 과 data/ 밑 패널은 .gitignore 로 막혀 있어 레포에 없다.
# 로컬은 각자 갖고 있으면 되지만 배포 서버엔 넣어줄 사람이 없어서 기동할 때 받아온다
# (scripts/start.sh 가 uvicorn 앞에서 실행). 예측 서버(Railway)에만 필요하고
# qmode 전용 배포(Render)는 모델을 안 쓰므로 필요 없다.
#
# 안 받아도 서버는 뜬다. 대신 /compare 가 수치를 못 내고 조용히 폴백으로 답한다 —
# 그래서 /health 의 artifacts.missing 으로 확인하는 게 유일한 단서다.
#
# ARTIFACT_SOURCE=hf     # hf(기본) | url | none. none 은 이미 파일이 있는 환경용
# HF_REPO_ID=suinnn/parallel-me-artifacts     # 비공개 레포
# HF_TOKEN=hf_...                             # 읽기 권한 토큰
# ARTIFACT_BASE_URL=https://.../artifacts     # ARTIFACT_SOURCE=url 일 때만
#
# 선택 항목(폴백 모델 4개 + KOWEPS 패널 15개)까지 받을지. 비우면 필수만 받는다.
# 없으면 청년(age ≤ 31) 라우팅에서 YP 패널 모델이 안 붙어 KLIPS 추정치로 내려가고,
# KOWEPS 개인화 매칭도 집단통계로만 답한다 — 둘 다 예외 없이 조용히 그렇게 된다.
# FETCH_OPTIONAL=1
#
# 현황 확인: python scripts/fetch_artifacts.py --check
