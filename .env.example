# 로컬 개발용 예시. 실제 키가 든 .env 는 커밋되지 않는다(.gitignore).
ANTHROPIC_API_KEY=sk-ant-...
DART_API_KEY=            # OpenDART 공시·재무 (기업 분석)
CAREERNET_API_KEY=       # 커리어넷 직업정보·직업가치관검사

# ── 배포할 때만 ────────────────────────────────────────────
# 우리 프론트 주소만 허용해 키 도용을 막는다. 비우면 전부 허용.
# ALLOWED_ORIGINS=https://내프론트주소
# PORT 는 호스팅 플랫폼이 준다(Render/Railway 등). 있으면 0.0.0.0 으로 바인딩한다.
